# Copy to .env and change every value marked change_me.
POSTGRES_DB=mm70
POSTGRES_USER=mm70
POSTGRES_PASSWORD=change_me_generate_with_openssl_rand_base64_32

# Generate with:
#   python3 - <<'PY'
#   import secrets
#   print(secrets.token_urlsafe(48))
#   PY
MM70_SECRET_KEY=change_me_generate_token_urlsafe_48

# Keep true behind a TLS reverse proxy. Set false only for local HTTP smoke tests.
MM70_SECURE_COOKIES=true

# Bind the app only to localhost by default; let cloudflared/TLS proxy reach it locally.
MM70_HOST_BIND=127.0.0.1
MM70_PORT=8000

# Only set if a trusted reverse proxy writes X-Forwarded-For.
MM70_TRUSTED_PROXY_CIDRS=127.0.0.1/32
