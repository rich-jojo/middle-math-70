{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://middle-math-70.local/schema/problem-bundle-v1.schema.json",
  "title": "Middle Math 70 Problem Bundle v1",
  "type": "object",
  "required": ["schema_version", "source", "problems", "exams"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" },
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/problem" }
    },
    "exams": {
      "type": "array",
      "items": { "$ref": "#/$defs/exam" }
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "required": [
        "external_key",
        "title",
        "body_html",
        "grade",
        "semester",
        "unit",
        "tags",
        "answer_type",
        "answer_spec",
        "level",
        "base_xp",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "external_key": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "body_html": { "type": "string", "minLength": 1 },
        "diagram_svg": { "type": "string" },
        "grade": { "type": "string" },
        "semester": { "type": "string" },
        "unit": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "answer_type": { "enum": ["choice", "text", "process"] },
        "choices": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 0,
          "maxItems": 8
        },
        "answer_spec": {
          "type": "object",
          "additionalProperties": true
        },
        "explanation_html": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 30 },
        "base_xp": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["draft", "published", "archived"] }
      }
    },
    "exam": {
      "type": "object",
      "required": ["slug", "title", "time_limit_seconds", "state", "items"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "minLength": 1, "maxLength": 120 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "time_limit_seconds": { "type": "integer", "minimum": 60 },
        "state": { "enum": ["draft", "published", "archived"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sequence", "problem_external_key", "points"],
            "additionalProperties": false,
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "problem_external_key": { "type": "string", "minLength": 1 },
              "points": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
